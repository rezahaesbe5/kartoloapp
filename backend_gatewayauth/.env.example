# Salin ke .env dan isi sesuai environment lokal Anda.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://<user>:<pass>@127.0.0.1:5432/<dbname>?schema=gateway_auth
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=gateway_auth

JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=kartolo:
SESSION_TTL_SECONDS=900
CAPTCHA_TTL_SECONDS=120

# Quote nilai dengan karakter `#` supaya dotenv tidak treat sebagai komentar.
SEED_SUPERADMIN_EMAIL=superadmin@kartolo.local
SEED_SUPERADMIN_PASSWORD=""
SEED_SUPERADMIN_NAME="Super Admin"

# ---- Logging / Observability ----
# Penanda app sumber log (slug nama folder) — masuk ke field "app" tiap record.
APP_ID=backend_gatewayauth
# Path relatif diresolusi dari cwd backend (backend_gatewayauth/).
LOG_DIR=./logs
FRONTEND_LOG_DIR=../frontend_kartoloapps/logs
LOGLOKI_DIR=../logloki
LOG_LINK_MODE=hardlink
LOKI_URL=http://127.0.0.1:3100
LOG_SAMPLE_SUCCESS_RATE=0.2
LOG_BODY_MAX_BYTES=32768
LOG_RETENTION_DAYS=90
