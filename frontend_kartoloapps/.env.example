# Dev env (vite serve). Vite baca file ini; FE fallback ke import.meta.env saat dev.
# (Produksi TIDAK pakai file ini — nilai runtime via build/.env.frontend + micro-server.)
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_NAME=Kartolo SuperApps
# Penanda app sumber log (slug nama folder) — masuk ke field "app" tiap record log.
VITE_APP_ID=frontend_kartoloapps

# Kartolo API Gateway client credentials (header X-Client-Id + HMAC signature).
# Diisi otomatis oleh `npm run db:seed` di backend.
VITE_CLIENT_ID=kartolo-web-frontend
