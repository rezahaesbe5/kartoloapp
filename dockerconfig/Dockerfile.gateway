# Gateway Auth — build dari SOURCE (bukan dari dist pre-compiled).
# Build context = project root (lihat docker-compose.yml: context: ..).
# Compile TypeScript di dalam container lalu jalankan hasil dist/.
FROM node:22-alpine
WORKDIR /app

# OpenSSL WAJIB sebelum prisma generate
RUN apk add --no-cache openssl

# 1) Install SEMUA dependency (termasuk devDependencies — butuh tsc & prisma).
COPY backend_gatewayauth/package.json backend_gatewayauth/package-lock.json ./
RUN npm ci

# 2) Copy source + prisma schema, generate client, compile TS → dist/.
COPY backend_gatewayauth/ ./
RUN npx prisma generate
RUN npm run build

EXPOSE 3000
CMD ["node", "dist/src/server.js"]
