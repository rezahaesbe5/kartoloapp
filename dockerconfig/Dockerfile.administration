# Administration — build dari SOURCE (bukan dari dist pre-compiled).
# Build context = project root (lihat docker-compose.yml: context: ..).
FROM node:22-alpine
WORKDIR /app

# OpenSSL WAJIB sebelum prisma generate
RUN apk add --no-cache openssl

COPY backend_administration/package.json backend_administration/package-lock.json ./
RUN npm ci

COPY backend_administration/ ./
RUN npx prisma generate
RUN npm run build

EXPOSE 3001
CMD ["node", "dist/src/server.js"]
