# Administration — build dari SOURCE (bukan dari dist pre-compiled).
# Build context = project root (lihat docker-compose.yml: context: ..).
# Compile TypeScript di dalam container lalu jalankan hasil dist/.
FROM node:22-alpine
WORKDIR /app

# OpenSSL WAJIB sebelum prisma generate (lihat catatan di Dockerfile.gateway).
RUN apk add --no-cache openssl

# 1) Install SEMUA dependency (termasuk devDependencies — butuh tsc & prisma).
COPY backend_administration/package.json backend_administration/package-lock.json ./
RUN npm ci

# 2) Copy source + prisma schema, generate client, compile TS → dist/.
COPY backend_administration/ ./
RUN npx prisma generate
RUN npm run build

EXPOSE 3001
CMD ["node", "dist/src/server.js"]
