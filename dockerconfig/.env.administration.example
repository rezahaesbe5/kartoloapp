# ============================================================================
# Kartolo Administration Backend — Production env (Docker)
# Copy ke .env.administration lalu isi nilai production. JANGAN commit.
#   cp .env.administration.example .env.administration
# ============================================================================

# ---- Server ----
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
APP_ID=backend_administration

# ---- Database (Postgres native VPS — sama dengan gateway) ----
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD@HOST_VPS:5433/db_kartolo?schema=gateway_auth

# ---- Redis (service Docker internal) ----
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=kartolo:ad:
CACHE_LIST_TTL_SECONDS=60
CACHE_ITEM_TTL_SECONDS=300
CACHE_INVALIDATION_CHANNEL=kartolo:cache:invalidate

# ---- WebSocket (live tail log: admin→gateway, gateway forward ke client) ----
# Shared secret WAJIB SAMA dengan .env.gateway.
INTERNAL_WS_SECRET=GANTI_internal_ws_secret

# ---- Logging / Observability ----
LOG_DIR=./logloki
LOGLOKI_DIR=./logloki
LOG_LINK_MODE=hardlink
LOG_SAMPLE_SUCCESS_RATE=0.2
LOG_BODY_MAX_BYTES=32768
LOKI_URL=http://loki:3100
# Peer dirs (gateway/frontend) — dalam network Docker tidak diperlukan untuk
# cross-service hardlink, tapi kode mungkin baca untuk path validation.
# Di Docker: peer container log tidak dibutuhkan (satu container, satu logloki).
PEER_GATEWAY_LOG_DIR=./logloki
PEER_FRONTEND_LOG_DIR=./logloki