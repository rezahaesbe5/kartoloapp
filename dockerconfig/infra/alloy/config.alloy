// Grafana Alloy — shipper log Kartolo.
// Memantau HANYA folder logloki/ (berisi hardlink yang dibuat backend),
// bukan folder log asli. Mem-parse JSON jadi label cardinality-rendah,
// lalu mengirim ke Loki.

// Penemuan file: poll tiap 10 dtk — bind mount /mnt/d (drvfs) tidak reliable
// untuk inotify, jadi discovery berbasis polling.
local.file_match "kartolo" {
	path_targets = [{
		"__path__" = "/logs-root/logloki/*.log",
		"job"      = "kartolo",
	}]
	sync_period = "10s"
}

loki.source.file "kartolo" {
	targets       = local.file_match.kartolo.targets
	forward_to    = [loki.process.kartolo.receiver]
	tail_from_end = false
}

loki.process "kartolo" {
	// Ambil source, app & level dari isi JSON untuk dijadikan label.
	stage.json {
		expressions = {
			source     = "source",
			app        = "app",
			level      = "level",
			ts_request = "ts_request",
		}
	}

	// Label cardinality-rendah saja. trace_id TIDAK dijadikan label.
	stage.labels {
		values = {
			source = "source",
			app    = "app",
			level  = "level",
		}
	}

	// Pakai timestamp dari record, bukan waktu ingest.
	stage.timestamp {
		source = "ts_request"
		format = "RFC3339"
	}

	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
