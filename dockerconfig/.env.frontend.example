# ============================================================================
# Kartolo Frontend — Runtime env (micro-server inject ke index.html).
#
# file ini DI-COMMIT ke GitHub (tidak ada secret aktual — nilai default saja).
# Nilai SEBENARNYA ada di build/.env.frontend (GITIGNORED, diedit manual di VPS).
#
# Cara kerja:
#   docker compose up -d
#     → mount build/.env.frontend ke container (/app/.env.frontend)
#     → server.mjs baca .env.frontend SAAT CONTAINER START
#     → inject ke index.html: window.__APP_ENV__ = {VITE_*: values}
#     → Browser load HTML → FE baca dari window.__APP_ENV__
#
# Ganti nilai: edit build/.env.frontend + docker compose restart frontend_kartoloapps
# (TANPA rebuild bundle — langsung aktif, tidak perlu docker compose build ulang)
#
# Di-commit ke Git: nilai DEFAULT (dari DB seed). Tidak perlu ubah di sini.
# Yang diedit di VPS: build/.env.frontend (di-gitignore, tidak di-commit).
# ============================================================================

# API base URL untuk browser → gateway.
# Dev Docker (tanpa Nginx): absolute URL (browser→gateway host port).
# VPS (dengan Nginx same-origin): relative path (/api/v1).
VITE_API_BASE_URL=/api/v1

# App name untuk UI
VITE_APP_NAME=Kartolo SuperApps

# App ID untuk logging (slug nama folder source)
VITE_APP_ID=frontend_kartoloapps

# Client credentials untuk HMAC signature (X-Client-Id + X-Signature).
# Default dari DB cfg_client seed. Sync dengan backend.
VITE_CLIENT_ID=kartolo-web-frontend
VITE_CLIENT_KEY=HiqgsukWJHLqY6YvI0EjKN19CpFcHEEjiTX5nsm7EUI=
