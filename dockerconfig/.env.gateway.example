# ============================================================================
# Kartolo Gateway Auth — Production env (Docker)
# Copy ke .env.gateway lalu isi nilai production. JANGAN commit .env.gateway.
#   cp .env.gateway.example .env.gateway
# ============================================================================

# ---- Server ----
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
APP_ID=backend_gatewayauth

# ---- CORS (origin frontend produksi) ----
# Same-origin via Nginx → cukup domain publik. Multi-origin pisah dgn koma.
CORS_ORIGIN=https://domainkamu.com

# ---- Database (Postgres native VPS) ----
# Ganti HOST/PORT/USER/PASSWORD sesuai Postgres VPS. ?schema=gateway_auth WAJIB.
# Dev lokal (Docker Desktop di Windows/WSL): gunakan host.docker.internal
#   DATABASE_URL=postgresql://postgres:PASSWORD@host.docker.internal:5433/db_kartolo?schema=gateway_auth
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD@HOST_VPS:5433/db_kartolo?schema=gateway_auth

# ---- JWT (WAJIB ganti — min 16 char, idealnya 32+) ----
# Generate: openssl rand -hex 32
JWT_SECRET=GANTI_dengan_openssl_rand_hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Redis (service Docker internal) ----
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=kartolo:
SESSION_TTL_SECONDS=900
CAPTCHA_TTL_SECONDS=120
PORTAL_CACHE_TTL_SECONDS=120
CACHE_INVALIDATION_CHANNEL=kartolo:cache:invalidate

# ---- Seed superadmin (dipakai prisma/seed.js) ----
SEED_SUPERADMIN_EMAIL=superadmin@kartolo.local
SEED_SUPERADMIN_PASSWORD="GANTI_Password#2026"
SEED_SUPERADMIN_NAME="Super Admin"
# URL administration untuk forward (nama service Docker, BUKAN localhost).
# Seed meng-upsert mst_endpoint.backend_url ke nilai ini — WAJIB agar gateway
# bisa forward request ke administration via Docker internal DNS.
SEED_ADMIN_BACKEND_URL=http://administration:3001

# ---- MFA (TOTP) ----
# Generate: openssl rand -base64 32
MFA_ENCRYPTION_KEY=GANTI_dengan_openssl_rand_base64_32
MFA_CHALLENGE_TTL_SECONDS=300
MFA_ISSUER=Kartolo SuperApps

# ---- WebSocket (live tail log gateway→admin) ----
ADMIN_BASE_URL=http://administration:3001
# Shared secret gateway↔admin (min 8 char). HARUS sama dgn .env.administration.
INTERNAL_WS_SECRET=GANTI_internal_ws_secret
WS_TICKET_TTL_SECONDS=30

# ---- Logging / Observability ----
# LOG_DIR menulis langsung ke volume bersama (dibaca alloy). WORKDIR=/app.
LOG_DIR=./logloki
FRONTEND_LOG_DIR=./logloki
LOGLOKI_DIR=./logloki
LOG_LINK_MODE=hardlink
LOKI_URL=http://loki:3100
LOG_SAMPLE_SUCCESS_RATE=0.2
LOG_BODY_MAX_BYTES=32768
LOG_RETENTION_DAYS=90
