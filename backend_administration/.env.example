# ============================================================================
# Kartolo SuperApps — Administration backend — template environment
# Salin ke .env dan sesuaikan. Service ini diakses hanya via backend_gatewayauth.
# ============================================================================

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug
APP_ID=backend_administration

# Sama dengan backend_gatewayauth — membaca + menulis gateway_auth.audit_logs.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=gateway_auth

# ---- Logging / Observability ----
LOG_DIR=./logs
LOGLOKI_DIR=../logloki
LOG_LINK_MODE=hardlink
LOG_SAMPLE_SUCCESS_RATE=1
LOG_BODY_MAX_BYTES=32768
